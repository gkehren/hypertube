import { Button, HorizontalBox, LineEdit, VerticalBox } from "std-widgets.slint";
import { ThemeTokens } from "theme.slint";
import { Theme } from "enums.slint";

export component PreferencesView inherits Rectangle {
	in property <Theme> selected-theme: Theme.dark;
	in property <bool> sidebar-collapsed: false;
	in property <string> state-message;
	in-out property <string> download-limit;
	in-out property <string> upload-limit;
	in-out property <string> download-path;
	in-out property <bool> enable-dht: true;
	in-out property <bool> enable-upnp: true;
	in-out property <bool> enable-natpmp: true;
	in-out property <bool> torznab-enabled: false;
	in-out property <string> torznab-url;
	in property <bool> torznab-secret-stored: false;
	in-out property <string> torznab-secret;
	in-out property <bool> proxy-enabled: false;
	in-out property <string> proxy-type: "socks5";
	in-out property <string> proxy-host;
	in-out property <string> proxy-port;
	in-out property <string> proxy-username;
	in property <bool> proxy-secret-stored: false;
	in-out property <string> proxy-secret;
	callback change-theme(Theme);
	callback toggle-sidebar();
	callback browse-download-directory();
	callback apply-preferences();
	callback clear-torznab-secret();
	callback clear-proxy-secret();

	background: ThemeTokens.background;
	VerticalBox {
		padding: 20px;
		Text { text: "Preferences"; color: ThemeTokens.foreground; font-size: 24px; }
		Text { text: root.state-message; color: ThemeTokens.muted-foreground; }

		Text { text: "Theme"; color: ThemeTokens.foreground; }
		HorizontalBox {
			Button { text: "Dark"; clicked => { root.change-theme(Theme.dark); } }
			Button { text: "Ocean"; clicked => { root.change-theme(Theme.ocean); } }
			Button { text: "Nord"; clicked => { root.change-theme(Theme.nord); } }
			Button { text: "Dracula"; clicked => { root.change-theme(Theme.dracula); } }
			Button { text: "CyberPunk"; clicked => { root.change-theme(Theme.cyberpunk); } }
		}

		Text { text: "Default torrent settings"; color: ThemeTokens.foreground; }
		HorizontalBox {
			Text { text: "Download limit (bytes/s, 0 = unlimited)"; color: ThemeTokens.muted-foreground; }
			LineEdit { text <=> root.download-limit; placeholder-text: "0"; }
			Text { text: "Upload limit"; color: ThemeTokens.muted-foreground; }
			LineEdit { text <=> root.upload-limit; placeholder-text: "0"; }
		}
		HorizontalBox {
			LineEdit { text <=> root.download-path; placeholder-text: "~/Downloads"; }
			Button { text: "Browse"; accessible-label: "Browse default download directory"; clicked => { root.browse-download-directory(); } }
		}

		Text { text: "Network discovery"; color: ThemeTokens.foreground; }
		HorizontalBox {
			Button { text: root.enable-dht ? "DHT enabled" : "DHT disabled"; clicked => { root.enable-dht = !root.enable-dht; } }
			Button { text: root.enable-upnp ? "UPnP enabled" : "UPnP disabled"; clicked => { root.enable-upnp = !root.enable-upnp; } }
			Button { text: root.enable-natpmp ? "NAT-PMP enabled" : "NAT-PMP disabled"; clicked => { root.enable-natpmp = !root.enable-natpmp; } }
		}

		Text { text: "Torznab search"; color: ThemeTokens.foreground; }
		HorizontalBox {
			Button { text: root.torznab-enabled ? "Enabled" : "Disabled"; clicked => { root.torznab-enabled = !root.torznab-enabled; } }
			LineEdit { text <=> root.torznab-url; placeholder-text: "http://127.0.0.1:9696/..."; }
		}
		HorizontalBox {
			LineEdit { text <=> root.torznab-secret; input-type: password; placeholder-text: root.torznab-secret-stored ? "API key stored (enter to replace)" : "API key"; }
			Text { text: root.torznab-secret-stored ? "Secret stored" : "No secret stored"; color: ThemeTokens.muted-foreground; }
			Button { text: "Clear stored secret"; enabled: root.torznab-secret-stored; clicked => { root.clear-torznab-secret(); } }
		}

		Text { text: "Proxy"; color: ThemeTokens.foreground; }
		HorizontalBox {
			Button { text: root.proxy-enabled ? "Enabled" : "Disabled"; clicked => { root.proxy-enabled = !root.proxy-enabled; } }
			Button { text: "SOCKS5"; enabled: root.proxy-type != "socks5"; clicked => { root.proxy-type = "socks5"; } }
			Button { text: "HTTP"; enabled: root.proxy-type != "http"; clicked => { root.proxy-type = "http"; } }
			LineEdit { text <=> root.proxy-host; placeholder-text: "127.0.0.1"; }
			LineEdit { text <=> root.proxy-port; placeholder-text: "1080"; }
		}
		LineEdit { text <=> root.proxy-username; placeholder-text: "Proxy username (password stays in credential store)"; }
		HorizontalBox {
			LineEdit { text <=> root.proxy-secret; input-type: password; placeholder-text: root.proxy-secret-stored ? "Password stored (enter to replace)" : "Proxy password"; }
			Text { text: root.proxy-secret-stored ? "Secret stored" : "No secret stored"; color: ThemeTokens.muted-foreground; }
			Button { text: "Clear stored secret"; enabled: root.proxy-secret-stored; clicked => { root.clear-proxy-secret(); } }
		}

		HorizontalBox {
			Button { text: root.sidebar-collapsed ? "Expand sidebar" : "Collapse sidebar"; clicked => { root.toggle-sidebar(); } }
			Rectangle { }
			Button { text: "Apply preferences"; clicked => { root.apply-preferences(); } }
		}
	}
}
