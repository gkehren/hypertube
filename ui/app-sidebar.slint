import { Button, ScrollView, VerticalBox } from "std-widgets.slint";
import { ThemeTokens } from "theme.slint";
import { CategoryRow } from "category-types.slint";
import { AppTab, TorrentCategory } from "enums.slint";

component SidebarButton inherits Rectangle {
	in property <string> label;
	in property <string> accessible-name;
	in property <bool> selected: false;
	in property <bool> tooltip-enabled: false;
	callback clicked();
	height: 38px;
	border-width: root.selected ? 2px : 0px;
	border-color: ThemeTokens.accent;
	border-radius: 5px;
	background: root.selected ? ThemeTokens.surface-hover : transparent;
	Text { text: root.label; color: ThemeTokens.foreground; horizontal-alignment: center; vertical-alignment: center; }
	TouchArea {
		accessible-role: button;
		accessible-label: root.accessible-name;
		clicked => { root.clicked(); }
		changed has-hover => { if (self.has-hover && root.tooltip-enabled) { tip.show(); } else { tip.close(); } }
	}
	tip := PopupWindow { x: root.width + 4px; width: 130px; height: 30px; Rectangle { background: ThemeTokens.surface-hover; border-width: 1px; border-color: ThemeTokens.border; Text { text: root.accessible-name; color: ThemeTokens.foreground; horizontal-alignment: center; vertical-alignment: center; } } }
}

export component AppSidebar inherits Rectangle {
	in property <int> sidebar-width: 240;
	in property <bool> collapsed: false;
	in property <AppTab> active-tab: AppTab.torrents;
	in property <TorrentCategory> category-filter: TorrentCategory.all;
	in property <[CategoryRow]> categories: [];
	callback add-torrent();
	callback torrents-tab();
	callback search-tab();
	callback favorites-tab();
	callback preferences-tab();
	callback logs-tab();
	callback select-category(TorrentCategory);
	background: ThemeTokens.surface;
	width: root.collapsed ? 56px : root.sidebar-width * 1px;
	VerticalBox {
		padding: root.collapsed ? 8px : 16px;
		Text { text: root.collapsed ? "H" : "Hypertube"; accessible-label: "Hypertube"; font-size: 22px; color: ThemeTokens.foreground; horizontal-alignment: center; }
		SidebarButton { label: root.collapsed ? "+" : "Add torrent"; accessible-name: "Add torrent"; tooltip-enabled: root.collapsed; clicked => { root.add-torrent(); } }
		SidebarButton { label: root.collapsed ? "T" : "Torrents"; accessible-name: "Torrents"; tooltip-enabled: root.collapsed; selected: root.active-tab == AppTab.torrents; clicked => { root.torrents-tab(); } }
		SidebarButton { label: root.collapsed ? "S" : "Search"; accessible-name: "Search"; tooltip-enabled: root.collapsed; selected: root.active-tab == AppTab.search; clicked => { root.search-tab(); } }
		SidebarButton { label: root.collapsed ? "F" : "Favorites"; accessible-name: "Favorites"; tooltip-enabled: root.collapsed; selected: root.active-tab == AppTab.favorites; clicked => { root.favorites-tab(); } }
		SidebarButton { label: root.collapsed ? "P" : "Preferences"; accessible-name: "Preferences"; tooltip-enabled: root.collapsed; selected: root.active-tab == AppTab.preferences; clicked => { root.preferences-tab(); } }
		SidebarButton { label: root.collapsed ? "L" : "Logs"; accessible-name: "Logs"; tooltip-enabled: root.collapsed; selected: root.active-tab == AppTab.logs; clicked => { root.logs-tab(); } }
		if (!root.collapsed && root.active-tab == AppTab.torrents): ScrollView {
			VerticalBox {
				Text { text: "Categories"; color: ThemeTokens.muted-foreground; font-size: 12px; }
				for category in root.categories: Rectangle {
					height: 36px; border-width: category.filter == root.category-filter ? 2px : 0px; border-color: ThemeTokens.accent; border-radius: 5px;
					Button { text: category.label + " (" + category.count + ")"; clicked => { root.select-category(category.filter); } }
				}
			}
		}
		Rectangle { }
	}
}
